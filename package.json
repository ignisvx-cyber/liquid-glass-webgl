{
  "name": "@ignisvx/liquid-glass-webgl",
  "version": "0.1.0",
  "description": "Reusable React WebGL Liquid Glass refraction effect, adapted from Archis Vaze (MIT)",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "LIBRARY.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignisvx-cyber/liquid-glass-webgl.git"
  },
  "keywords": [
    "react",
    "liquid-glass",
    "webgl",
    "refraction",
    "ios26",
    "glassmorphism",
    "lovable"
  ],
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/LiquidGlass.js && node --check src/gl.js && node --check src/shaders.js"
  },
  "engines": {
    "node": ">=18"
  }
}
