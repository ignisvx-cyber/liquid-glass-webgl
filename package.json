{
  "name": "@ignisvx/liquid-glass-webgl",
  "version": "0.2.0",
  "description": "Reusable React liquid-glass buttons and WebGL refraction surface for Lovable",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "LICENSE",
    "LIBRARY.md"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignisvx-cyber/liquid-glass-webgl.git"
  },
  "keywords": [
    "react",
    "liquid-glass",
    "glass-button",
    "webgl",
    "refraction",
    "lovable",
    "glassmorphism"
  ],
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/LiquidGlass.js && node --check src/LiquidGlassButton.js && node --check src/gl.js && node --check src/shaders.js"
  },
  "engines": {
    "node": ">=18"
  }
}
